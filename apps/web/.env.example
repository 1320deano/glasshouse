# Copy to .env.local. Values come from the Supabase dashboard: Project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the ingest route to write events on behalf of a connector.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Optional. With it the Room writes AI headlines, names the parts of your app and describes files.
# Without it everything runs from templates and folder names. Every call is logged with its cost.
ANTHROPIC_API_KEY=
# Optional overrides: the model (default claude-opus-5), a kill switch (GLASSHOUSE_AI=off), the USD to GBP rate for cost logging.
GLASSHOUSE_AI_MODEL=
GLASSHOUSE_AI=
GLASSHOUSE_USD_GBP=

# --- Phase 4: hosted mode only (leave blank on a laptop) ---
# The public address of the Room, used in sign-in links and Stripe return addresses.
NEXT_PUBLIC_SITE_URL=
# Who may open /admin (comma-separated emails). Local mode is always admin.
GLASSHOUSE_ADMIN_EMAILS=
# 1 = only invited emails (added on /admin) can sign in. Leave blank for public sign-up.
GLASSHOUSE_INVITE_ONLY=
# Preview the free tier on a laptop: free. Blank = Pro (everything on).
GLASSHOUSE_PLAN=
# The product name and the command shown on pages, once the name is decided (docs/name-decision.md).
NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_CONNECT_COMMAND=
NEXT_PUBLIC_PRO_PRICE_GBP=
# Stripe (optional until launch). Without these, Pro is switched on by hand from /admin.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=
# Scripts only: lets a request without sign-in create projects and read everything. Keep secret.
GLASSHOUSE_SETUP_SECRET=
