# Copy to .env.local. Values come from the Supabase dashboard: Project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the ingest route to write events on behalf of a connector.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Optional. With it the Room writes AI headlines, names the parts of your app and describes files.
# Without it everything runs from templates and folder names. Every call is logged with its cost.
ANTHROPIC_API_KEY=
# Optional overrides: the model (default claude-opus-5), a kill switch (GLASSHOUSE_AI=off), the USD to GBP rate for cost logging.
GLASSHOUSE_AI_MODEL=
GLASSHOUSE_AI=
GLASSHOUSE_USD_GBP=
